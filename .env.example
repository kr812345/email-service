# Required: API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# Optional: path to the sender registry (default: ./senders.json)
# SENDERS_FILE=senders.json

# --- HTTP mode (VPS / remote agents) ----------------------------------------
# Set to serve MCP over streamable HTTP instead of stdio.
# MCP_HTTP_ADDR=127.0.0.1:8787
# Required in HTTP mode — clients must send "Authorization: Bearer <token>".
# Generate with: openssl rand -hex 32
# MCP_AUTH_TOKEN=

# Optional: override the Resend API base URL (testing / proxy only)
# RESEND_API_BASE=https://api.resend.com
